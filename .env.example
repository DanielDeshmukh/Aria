# Server-side only — never expose to the browser.
# Local: copy to .env (gitignored). On Vercel: set these in
# Project Settings -> Environment Variables (Production + Preview) —
# the .env file itself is never uploaded (.vercelignore).
DEEPGRAM_API_KEY=
GROQ_API_KEY=
SARVAM_API_KEY=
# Optional overrides (defaults: openai/gpt-oss-120b / bulbul:v4-flash / multi)
# GROQ_MODEL=
# GROQ_FALLBACK_MODEL=  # second Groq model tried on 429/outage (default openai/gpt-oss-20b)
# GROQ_SUMMARY_MODEL=   # end-of-call summary model; defaults to GROQ_FALLBACK_MODEL (never the live-chat primary)
# SARVAM_VOICE=
# STT_LANGUAGE=       # Deepgram language; set en-IN for English-only input
